# Database
DATABASE_URL=postgresql://user:password@localhost:5432/healthguide

# JWT
JWT_SECRET=your-jwt-secret-here
JWT_REFRESH_SECRET=your-jwt-refresh-secret-here
PASSWORD_RESET_SECRET=your-password-reset-secret-here

# Server
PORT=8000
NODE_ENV=development

# ML Prediction API (Python FastAPI service)
ML_API_URL=http://localhost:8001
GROQ_API_KEY=your-groq-api-key
GROQ_MODEL=qwen/qwen3-32b

# Frontend URL (used in email links)
FRONTEND_URL=http://localhost:3000

# SMTP (Nodemailer) for OTP and appointment emails
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-smtp-user
SMTP_PASS=your-smtp-password
EMAIL_FROM="HealthGuide <no-reply@example.com>"

# Cloudinary signed uploads. API secret is required for signed uploads.
CLOUDINARY_CLOUD_NAME=aayushmhrznn
CLOUDINARY_API_KEY=your-cloudinary-api-key
CLOUDINARY_API_SECRET=your-cloudinary-api-secret
# The API key must have Upload permission, or use an unsigned upload preset on the frontend.
