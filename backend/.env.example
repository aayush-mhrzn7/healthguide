# Database
DATABASE_URL=postgresql://user:password@localhost:5432/healthguide

# JWT
JWT_SECRET=your-jwt-secret-here
JWT_REFRESH_SECRET=your-jwt-refresh-secret-here

# Server
PORT=8000
NODE_ENV=development

# ML Prediction API (Python FastAPI service)
ML_API_URL=http://localhost:8001

# Quiz
QUIZ_QUESTION_COUNT=12

# Resend (email OTP). Use a verified domain "from" in production.
RESEND_API_KEY=
RESEND_FROM_EMAIL=onboarding@resend.dev
