# Directory containing model.joblib + metadata.json (after training)
MODEL_DIR=models_saved

# Training data CSV (used by app/ml/train.py)
TRAIN_DATA_PATH=data/raw/training_data.csv

# Optional: where preprocess snapshot is written during training
PROCESSED_DATA_DIR=data/processed

# Comma-separated origins for CORS (default * allows any origin)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
